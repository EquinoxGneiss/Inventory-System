# Copy to .env.local and fill in values for your environment. Never commit real values.
# Phase 1 runs entirely on built-in demo data and does not need these yet.
# Phase 2+ uses a hosted Supabase dev project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
